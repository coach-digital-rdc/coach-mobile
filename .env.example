# Android emulator: 10.0.2.2 reaches the computer running the API
# Physical phone: use the IP address of the computer on the same Wi-Fi
# iOS simulator: http://localhost:3000/sl/api
API_URL=http://10.0.2.2:3000/sl/api
# Lowercase, identical to COUNTRY in the backend
COUNTRY=sl
# OTP or PASSWORD
LOGIN_MODE=OTP

# OPTIONAL FEATURES
FEATURE_FLAG_TLC=
