# Android emulator: 10.0.2.2 reaches the computer running the API
# Physical phone: use the IP address of the computer on the same Wi-Fi
# iOS simulator: http://localhost:3000/api
API_URL=http://10.0.2.2:3000/api
# OTP or PASSWORD
LOGIN_MODE=OTP
# Grid, document checklist and PDP rules loaded on first start, before the first sync (DRC)
SEEDS=SEED_CD_INSERT_COMPETENCIES,SEED_CD_INSERT_QUESTIONS,SEED_CD_INSERT_CHECKLIST,SEED_CD_INSERT_PDP_RULE_SET,SEED_CD_INSERT_PDP_LIBRARY

# OPTIONAL FEATURES
FEATURE_FLAG_TLC=
